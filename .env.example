# =====================================================================
# SPETS SECURITY BOT — Environment Variables
# Copy this file to .env (locally) or set in Railway → Variables
# DO NOT COMMIT REAL VALUES TO GIT
# =====================================================================

# Telegram (from @BotFather)
TELEGRAM_TOKEN=your_new_token_here

# Your Telegram chat ID for admin notifications
# Get it: send /start to @userinfobot to find your chat ID
ADMIN_CHAT_ID=123456789

# Resend (from resend.com → API Keys)
# Free tier: 100 emails/day, 3,000/month — permanent free
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx

# Sender — using Resend test domain until spetstech.co.uk DNS is moved to Cloudflare
# Customer's "Reply" button still goes to REPLY_TO_EMAIL (your real Gmail/work email)
SENDER_EMAIL=onboarding@resend.dev
SENDER_NAME=Spets Security LTD
REPLY_TO_EMAIL=r.brain@spetstech.co.uk

# Future — KeyCRM integration (Phase 2 via n8n)
# KEYCRM_API_KEY=...
# N8N_WEBHOOK_URL=https://your-n8n.railway.app/webhook/spets-quote
